PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tracelog
CORS_ORIGINS=http://localhost:3000

RETRIEVAL_MODE=memory
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

MAX_LOG_BYTES=200000
MAX_RUNBOOK_BYTES=500000
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.30
STORE_RAW_LOGS=false
